# GQLSleuth Assessment

{% macro render_section(section, level=2) %}
{{ "#" * level }} {{ section.title }}

{% for paragraph in section.paragraphs %}
{{ paragraph | markdown_text }}

{% endfor %}
{% if section.rows %}
| Metric | Value |
| --- | --- |
{% for label, value in section.rows %}
| {{ label | markdown_text }} | {{ value | markdown_text }} |
{% endfor %}

{% endif %}
{% if section.table_rows %}
| {{ section.table_headers | map('markdown_text') | join(' | ') }} |
|{{ ' --- |' * (section.table_headers | length) }}
{% for row in section.table_rows %}
| {{ row | map('markdown_text') | join(' | ') }} |
{% endfor %}

{% endif %}
{% for entry in section.entries %}
{{ "#" * (level + 1) }} {{ entry.title | markdown_text }}

{% for label, value in entry.details %}
- **{{ label | markdown_text }}:** {{ value | markdown_text }}
{% endfor %}

{% for paragraph in entry.paragraphs %}
{{ paragraph | markdown_text }}

{% endfor %}
{% for language, text in entry.code_blocks %}
{{ text | fenced(language) }}

{% endfor %}
{% if entry.request_blocks %}
{{ "#" * (level + 2) }} Request

{% for language, text in entry.request_blocks %}
{% if language == 'json' %}
Variables:

{% endif %}
{{ text | fenced(language) }}

{% endfor %}
{% endif %}
{% if entry.response %}
{{ "#" * (level + 2) }} Response

{% for label, value in entry.response.details %}
- **{{ label }}:** {{ value | markdown_text }}
{% endfor %}

{% if entry.response.body is not none %}
{% if entry.response.body.notice %}
{{ entry.response.body.notice | markdown_text }}

{% endif %}
{% if entry.response.body.text %}
{{ entry.response.body.text | fenced(entry.response.body.language) }}

{% endif %}
{% else %}
No HTTP response was received; no server response body is available.

{% endif %}
{% endif %}
{% endfor %}
{% if not section.paragraphs and not section.rows and not section.entries and not section.table_rows and not section.children %}
None recorded.

{% endif %}
{% for child in section.children %}
{{ render_section(child, [level + 1, 4] | min) }}
{% endfor %}
{% endmacro %}
{% for section in sections %}
{{ render_section(section) }}
{% endfor %}
