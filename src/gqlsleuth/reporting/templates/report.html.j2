<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta http-equiv="Content-Security-Policy" content="default-src 'none'; style-src 'unsafe-inline'">
  <title>GQLSleuth Security Analysis Report</title>
  <style>
    :root { color-scheme: light; font-family: system-ui, sans-serif; color: #172a3a; background: #f3f5f7; }
    body { margin: 0; padding: 2rem 1rem; line-height: 1.6; }
    main { max-width: 1050px; margin: auto; background: white; padding: 2rem; border-top: 5px solid #236278; }
    h1 { font-size: 2rem; line-height: 1.2; margin-top: 0; }
    h2 { margin-top: 2.5rem; border-bottom: 1px solid #ccd7dd; padding-bottom: .5rem; }
    h3 { font-size: 1.1rem; margin-top: 1.7rem; }
    p, td, dd, h2, h3, h4, h5, h6 { overflow-wrap: anywhere; }
    table { width: 100%; border-collapse: collapse; margin: 1rem 0; }
    th, td { text-align: left; border-bottom: 1px solid #e0e6e9; padding: .5rem .75rem; }
    th { background: #edf3f6; }
    dl { display: grid; grid-template-columns: minmax(8rem, 13rem) 1fr; gap: .25rem 1rem; }
    dt { font-weight: 600; } dd { margin: 0; }
    pre { padding: 1rem; overflow-x: auto; background: #f0f4f6; border-left: 3px solid #6994a4; }
    code { font-family: ui-monospace, Consolas, monospace; font-size: .9rem; }
    main > section, main > details { margin-top: 2rem; border-top: 1px solid #ccd7dd; padding-top: 1rem; }
    article { margin: 2rem 0; padding-bottom: 1rem; }
    article + article { border-top: 1px solid #e0e6e9; padding-top: 1rem; }
    .endpoint { margin: 1.5rem 0 1rem; color: #236278; font-size: 1rem; }
    .help-text, .empty-state { color: #52616b; }
    .request, .response { margin-top: 1.5rem; }
    .subsection { font-size: 1rem; margin: 1.25rem 0 .5rem; }
    .body-label { margin-top: 1.25rem; }
    details { margin: 1rem 0; padding: .75rem 1rem; border: 1px solid #ccd7dd; }
    summary { cursor: pointer; font-weight: 600; overflow-wrap: anywhere; }
    @media (max-width: 600px) { main { padding: 1rem; } dl { grid-template-columns: 1fr; } }
  </style>
</head>
<body>
<main>
  <h1>GQLSleuth Assessment</h1>
{% macro heading(text, level, class_name='') %}
{% if level <= 6 %}
<h{{ level }}{% if class_name %} class="{{ class_name }}"{% endif %}>{{ text }}</h{{ level }}>
{% else %}
<p class="subsection {{ class_name }}"><strong>{{ text }}</strong></p>
{% endif %}
{% endmacro %}
{% macro render_section(section, level=2) %}
{% if section.collapsed %}
<details class="technical">
<summary>{{ section.title }}</summary>
{% else %}
  <section>
{% if section.title %}
    {{ heading(section.title, level) }}
{% endif %}
{% endif %}
{% for paragraph in section.paragraphs %}
    <p{% if section.title not in ('Important Limitations', 'Safety Notice') %} class="help-text"{% endif %}>{{ paragraph | brief }}</p>
{% endfor %}
{% if section.endpoint %}
    {{ heading('Endpoint: ' ~ section.endpoint, level + (1 if section.title else 0), 'endpoint') }}
{% endif %}
{% set entry_level = level + 1 + (1 if section.endpoint and section.title else 0) %}
{% if section.rows %}
    <table><thead><tr><th scope="col">Metric</th><th scope="col">Value</th></tr></thead><tbody>
{% for label, value in section.rows %}
      <tr><td>{{ label }}</td><td>{{ value | brief }}</td></tr>
{% endfor %}
    </tbody></table>
{% endif %}
{% if section.table_rows %}
    <table><thead><tr>{% for header in section.table_headers %}<th scope="col">{{ header }}</th>{% endfor %}</tr></thead><tbody>
{% for row in section.table_rows %}
      <tr>{% for value in row %}<td>{{ value }}</td>{% endfor %}</tr>
{% endfor %}
    </tbody></table>
{% endif %}
{% for entry in section.entries %}
    <article>
      {{ heading(entry.title | brief, entry_level) }}
{% if entry.execution %}
      {{ heading('Execution', entry_level + 1, 'subsection') }}
{% endif %}
{% if entry.details %}
      <dl>
{% for label, value in entry.details %}
        <dt>{{ label }}</dt><dd>{{ value | brief }}</dd>
{% endfor %}
      </dl>
{% endif %}
{% if entry.evidence_references %}
      <details>
        <summary>Evidence references</summary>
        <dl>
{% for label, value in entry.evidence_references %}
          <dt>{{ label }}</dt><dd>{{ value }}</dd>
{% endfor %}
        </dl>
      </details>
{% endif %}
{% for paragraph in entry.paragraphs %}
      <p>{{ paragraph if section.title == 'AI-Assisted Interpretation' else paragraph | brief }}</p>
{% endfor %}
{% for language, text in entry.code_blocks %}
      <pre><code class="language-{{ language }}">{{ text }}</code></pre>
{% endfor %}
{% if entry.request_blocks %}
      <section class="request">
      {{ heading('Request', entry_level + 1, 'subsection') }}
{% for language, text in entry.request_blocks %}
{% if language == 'json' %}
      <p>Variables:</p>
{% elif language == 'graphql' %}
      <p>GraphQL document:</p>
{% endif %}
      <pre><code class="language-{{ language }}">{{ text }}</code></pre>
{% endfor %}
      </section>
{% endif %}
{% if entry.response %}
      <details class="response">
        <summary>{{ entry.response.summary }}</summary>
        <p><strong>Metadata</strong></p>
        <dl>
{% for label, value in entry.response.details %}
          <dt>{{ label }}</dt><dd>{{ value }}</dd>
{% endfor %}
        </dl>
{% if entry.response.body is not none %}
        <p class="body-label"><strong>Body</strong></p>
{% if entry.response.body.notice %}
        <p>{{ entry.response.body.notice }}</p>
{% endif %}
{% if entry.response.body.text %}
        <pre><code class="language-{{ entry.response.body.language }}">{{ entry.response.body.text }}</code></pre>
{% endif %}
{% else %}
        <p>No HTTP response was received; no server response body is available.</p>
{% endif %}
      </details>
{% endif %}
    </article>
{% endfor %}
{% if not section.paragraphs and not section.rows and not section.entries and not section.table_rows and not section.children %}
    <p class="empty-state">None recorded.</p>
{% endif %}
{% for child in section.children %}
{{ render_section(child, level + 1) }}
{% endfor %}
{% if section.collapsed %}</details>{% else %}</section>{% endif %}
{% endmacro %}
{% for section in sections %}
{{ render_section(section) }}
{% endfor %}
</main>
</body>
</html>
